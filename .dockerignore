# =============================================================================
#  .dockerignore — exclut du contexte Docker tout ce qui n'est pas nécessaire
#  au build du binaire `cyberdeck-emu`.  Réduit le contexte uploadé au daemon
#  et accélère les rebuilds.
# =============================================================================

# Outputs de build
target/
**/target/

# Documents & artefacts
*.md
docs/
docker-compose*.yml
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Fichiers temporaires
**/*.bk
**/*.log
Cargo.lock.bak
